# ==============================================================================
# JobBoard DevSecOps Platform - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env for local development. Never commit .env!

# Node Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Frontend Client URL & CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_URL=http://localhost:3001/api

# Database Configuration (PostgreSQL)
POSTGRES_USER=jobboard_user
POSTGRES_PASSWORD=jobboard_secure_password_dev_only
POSTGRES_DB=jobboard_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://jobboard_user:jobboard_secure_password_dev_only@localhost:5432/jobboard_db

# Redis Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_development_purposes_only_minimum_32_chars_long!
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Observability
METRICS_PORT=3001
METRICS_PATH=/metrics
ENABLE_PROMETHEUS=true
