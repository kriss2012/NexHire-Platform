# ==============================================================================
# NexHire Talent & DevSecOps Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development. Never commit .env with real secrets!

# Node Runtime Environment (Enables production mode and optimization)
# Value: 'production' | 'development' | 'test'
NODE_ENV=production

# Server Port (Render / Koyeb dynamically sets PORT)
# Default for production: 10000 or 5000; local: 3001
PORT=5000

# Server Host
HOST=0.0.0.0

# Logging Verbosity ('error' | 'warn' | 'info' | 'debug')
LOG_LEVEL=info

# Allowed Origins for CORS (Allows browser requests to the API)
# Use '*' to allow requests or comma-separated list of domains
CORS_ORIGINS=*

# Frontend API URL (for Vite build)
# Leave blank or relative '/api' when using unified single-process hosting on Render.
# For decoupled frontend (e.g. Vercel), set to your backend URL: https://your-backend.onrender.com/api
VITE_API_URL=/api

# Authentication Secret (Used to sign & verify JWT login tokens)
# Minimum 32 characters (or click 'Generate' on Render)
JWT_SECRET=replace_with_a_secure_random_32_character_string_for_production
JWT_EXPIRES_IN=1h

# Database Configuration (PostgreSQL)
# Supports Neon Serverless Postgres, Supabase, Render PostgreSQL, or local Docker.
# Note: If unset or unreachable, NexHire automatically falls back to an in-memory database store.
# Example Neon: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Redis Caching (Optional)
# Supports Upstash Redis or local Redis.
# If unset or unreachable, NexHire automatically falls back to an in-memory LRU cache.
REDIS_URL=
REDIS_TTL_SECONDS=300

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
